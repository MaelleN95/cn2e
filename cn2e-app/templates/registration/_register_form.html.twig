<div class="bg-white border border-border rounded p-8">

    <h2 class="text-center text-2xl font-semibold mb-6">
        Demande de création de compte
    </h2>

  {# ERREURS FORM #}
  {% if registrationForm.vars.errors|length > 0 %}
    <div class="mb-6 p-4 bg-red-100 text-red-800 rounded">
      <ul>
        {% for error in registrationForm.vars.errors %}
          <li>{{ error.message }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

    {{ form_start(registrationForm, {
        attr: {
            class: 'space-y-6'
        }
    }) }}

    <div class="grid md:grid-cols-2 gap-4">

        {{ form_row(registrationForm.lastName) }}

        {{ form_row(registrationForm.firstName) }}

    </div>

    {{ form_row(registrationForm.email) }}

    {{ form_row(registrationForm.establishment) }}

    {{ form_row(registrationForm.profession) }}

    {{ form_row(registrationForm.requestMessage) }}

    {{ form_row(registrationForm.plainPassword) }}

    {{ form_row(registrationForm.agreeTerms) }}

    {{ form_widget(registrationForm.website) }}

    {# Timing #}
    <input type="hidden" name="_form_start_time" value="{{ 'now'|date('U') }}">

    <button
        type="submit"
        class="w-full bg-primary text-primary-foreground px-6 py-3 rounded hover:bg-primary/80 transition-colors cursor-pointer"
    >
        Envoyer la demande
    </button>

    <p class="text-sm text-muted-foreground text-center">
        Votre demande sera examinée par l'équipe du CN2E. Vous recevrez une réponse par email sous 48 heures ouvrées.
    </p>

    {{ form_end(registrationForm) }}

</div>