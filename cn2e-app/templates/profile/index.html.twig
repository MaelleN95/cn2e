{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
{% include 'components/breadcrumb.html.twig' with {
  items: [
    { label: 'Mon profil' }
  ]
} %}

<section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="mb-4 text-center">Mon profil</h1>

    {% include 'components/flash_messages.html.twig' %}

    <div class="bg-white border border-border rounded p-8">
        <h2 class="font-semibold mb-6">Modifier mes informations</h2>

        {{ form_start(profileForm, {
            attr: {
                class: 'space-y-6'
            }
        }) }}

        {{ form_errors(profileForm) }}

        <div class="grid md:grid-cols-2 gap-4">
            {{ form_row(profileForm.lastName) }}
            {{ form_row(profileForm.firstName) }}
        </div>

        {{ form_row(profileForm.email) }}
        {{ form_row(profileForm.establishment) }}
        {{ form_row(profileForm.profession) }}

        {% if is_granted('ROLE_CN2E_MEMBER') %}
            <div>
                <label class="block mb-2" for="cn2e_role_display">{{ 'form.profile.cn2e_role'|trans }}</label>
                <input
                    id="cn2e_role_display"
                    type="text"
                    value="{{ user.cn2eRole ?: 'Non renseigné' }}"
                    disabled
                    class="w-full px-4 py-3 border border-border rounded bg-secondary text-muted-foreground cursor-not-allowed"
                >
            </div>
        {% endif %}

        {{ form_row(profileForm.imageFile) }}

        <button
            type="submit"
            class="w-full bg-primary text-primary-foreground px-6 py-3 rounded hover:bg-primary/80 transition-colors cursor-pointer"
        >
            Enregistrer mes modifications
        </button>

        <div class="pt-5 border-t border-border">
            <p class="text-sm text-muted-foreground mb-3 text-center">
                Besoin de modifier votre mot de passe ?
            </p>
            <a href="{{ path('app_forgot_password_request') }}"
               class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded border border-primary text-primary font-medium hover:bg-primary hover:text-primary-foreground transition-colors">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                Réinitialiser mon mot de passe
            </a>
        </div>

        {{ form_end(profileForm) }}
    </div>
</section>
{% endblock %}
