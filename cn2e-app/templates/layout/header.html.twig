{% set navLinks = [
  { route: 'app_home', label: 'Accueil' },
  { route: 'app_establishment', label: 'Établissements' },
  { route: 'app_article', label: 'Actualités' },
  { route: 'app_event', label: 'Agenda' },
  { route: 'app_contact', label: 'Contact' }
] %}
{% set canAccessProfile = app.user and (is_granted('ROLE_CN2E_MEMBER') or is_granted('ROLE_LOCAL_ADMIN')) %}

<header
  class="fixed top-0 left-0 w-full z-2000 bg-white border-b border-border shadow-sm transition-transform duration-300"
  data-controller="scroll-header-movement mobile-menu"
  data-scroll-header-movement-target="header"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex justify-between items-center h-16">
      
      <div class="flex items-center gap-4">

        <a href="/" 
          class="flex items-center gap-3 
          {% if app.request.get('_route') == 'app_home' %} 
            pointer-events-none
          {% endif %}"
        >
          <div class="w-12 h-12 rounded flex items-center justify-center">
            <img
                src="{{ asset('images/logos/logo-CN2E-black.png') }}"
                alt="Logo du {{ siteInformation.shortName }}"
            >
          </div>
        </a>

        {% if app.user %}
          <span class="text-primary block md:hidden xl:block">
            Bonjour, {{ app.user.firstName }} {{ app.user.lastName }}
          </span>
        {% endif %}

      </div>
      

      {# Desktop #}
      <nav class="hidden md:flex items-center gap-6">
        {% for link in navLinks %}
          <a href="{{ path(link.route) }}"
             class="transition-colors
              {% if app.request.get('_route') == link.route %}
                text-primary font-semibold pointer-events-none
              {% else %}
                text-foreground hover:text-primary
              {% endif %}">
            {{ link.label }}
          </a>
        {% endfor %}

        {% if canAccessProfile %}
          <a href="{{ path('app_profile') }}"
            class="px-4 py-2 2xl:py-1.5 border border-primary rounded hover:bg-primary hover:text-white transition-colors
            {% if app.request.get('_route') == 'app_profile' %}
              bg-primary text-white pointer-events-none
            {% else %}
              text-primary hover:text-primary
            {% endif %}">

            <svg class="w-5 h-5 block 2xl:hidden"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round">
              <path d="M11.5 15H7a4 4 0 0 0-4 4v2"/>
              <path d="M21.378 16.626a1 1 0 0 0-3.004-3.004l-4.01 4.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/>
              <circle cx="10" cy="7" r="4"/>
            </svg>

            <span class="hidden 2xl:inline">
              Mon profil
            </span>

            <span class="sr-only">Mon profil</span>

          </a>
        {% endif %}

        {% if app.user and is_granted('ROLE_LOCAL_ADMIN') %}
          <a href="{{ path('admin') }}"
            class="px-4 py-1.5 border border-primary text-primary rounded hover:bg-primary hover:text-white transition-colors">

            <span class="lg:block hidden">
              Administration
            </span>

            <span class="lg:hidden block">
              <span class="sr-only">Administration</span>

              <svg class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                <path d="M12 17v4"/>
                <path d="m14.305 7.53.923-.382"/>
                <path d="m15.228 4.852-.923-.383"/>
                <path d="m16.852 3.228-.383-.924"/>
                <path d="m16.852 8.772-.383.923"/>
                <path d="m19.148 3.228.383-.924"/>
                <path d="m19.53 9.696-.382-.924"/>
                <path d="m20.772 4.852.924-.383"/>
                <path d="m20.772 7.148.924.383"/>
                <path d="M22 13v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7"/>
                <path d="M8 21h8"/>
                <circle cx="18" cy="6" r="3"/>
              </svg>
            </span>

          </a>
        {% endif %}

        {% if app.user %}
          <a href="{{ path('app_logout') }}"
            class="px-4 py-2 border border-red-800 text-red-700 rounded hover:bg-red-800 hover:text-white transition-colors">
            <span class="sr-only">Déconnexion</span>
              <svg class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                  <polyline points="16 17 21 12 16 7"/>
                  <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
          </a>
        {% else %}
          <a href="{{ path('app_login') }}"
            class="px-4 py-2 border border-primary text-primary rounded hover:bg-primary hover:text-white transition-colors">
            Connexion
          </a>
        {% endif %}
      </nav>

      {# Burger #}
      <button
        class="md:hidden p-2 cursor-pointer relative w-10 h-10 flex items-center justify-center"
        data-mobile-menu-target="button"
        data-action="click->mobile-menu#toggle"
        aria-label="Menu"
        aria-expanded="false"
      >
        <span class="relative w-6 h-6">
          
          <!-- Line 1 -->
          <span
            data-mobile-menu-target="line1"
            class="absolute left-0 top-0 w-6 h-0.5 bg-foreground transition-all duration-300"
          ></span>

          <!-- Line 2 -->
          <span
            data-mobile-menu-target="line2"
            class="absolute left-0 top-2.5 w-6 h-0.5 bg-foreground transition-all duration-300"
          ></span>

          <!-- Line 3 -->
          <span
            data-mobile-menu-target="line3"
            class="absolute left-0 top-5 w-6 h-0.5 bg-foreground transition-all duration-300"
          ></span>

        </span>
      </button>

    </div>

    {# Mobile menu #}
    <nav
      class="hidden md:hidden flex pb-4 flex-col gap-3 z-50"
      data-mobile-menu-target="menu"
    >
      {% for link in navLinks %}
        <a href="{{ path(link.route) }}"
           data-action="click->mobile-menu#close"
           class="transition-colors
            {% if app.request.get('_route') == link.route %}
              text-primary font-semibold pointer-events-none
            {% else %}
              text-foreground hover:text-primary
            {% endif %}">
          {{ link.label }}
        </a>
      {% endfor %}

      {% if canAccessProfile %}
        <a href="{{ path('app_profile') }}"
           data-action="click->mobile-menu#close"
           class="transition-colors">
          Mon profil
        </a>
      {% endif %}

      {% if app.user and is_granted('ROLE_LOCAL_ADMIN') %}
        <a href="{{ path('admin') }}"
           data-action="click->mobile-menu#close"
           class="transition-colors text-primary">
          Administration
        </a>
      {% endif %}

      {% if app.user %}
        <a href="{{ path('app_logout') }}"
           data-action="click->mobile-menu#close"
           class="text-red-800 hover:underline">
          Déconnexion
        </a>
      {% else %}
        <a href="{{ path('app_login') }}"
           data-action="click->mobile-menu#close"
           class="text-primary hover:underline">
          Connexion
        </a>
      {% endif %}
    </nav>
  </div>
</header>
