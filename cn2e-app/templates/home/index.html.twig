{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

<div>

{# HERO #}
<section
    class="bg-primary text-white py-30 px-4 bg-cover"
    style="background-image: url('{{ asset('images/nuage-cn2e.webp') }}');"
>

    {% include 'components/flash_messages.html.twig' %}

    <div class="max-w-7xl mx-auto text-center">

        <h1 class="text-4xl md:text-5xl mb-4">
            Comité National des EREA/LEA et ERPD
        </h1>

        <p class="text-xl md:text-2xl mb-8 text-white/90 max-w-3xl mx-auto">
            Instance de coordination et de représentation de l'enseignement adapté
        </p>

        <a href="{{ path('app_establishment') }}"
           class="inline-block bg-white text-primary px-8 py-3 rounded hover:bg-gray-200 transition-colors cursor-pointer">
            Voir les établissements
        </a>

    </div>

</section>


{# ACTUALITÉS #}
<section class="py-16 px-4 bg-accent">

    <div class="max-w-7xl mx-auto">

        <h2 class="text-center mb-8">Actualités</h2>

        <div class="grid md:grid-cols-3 gap-6 mb-8">

            {% for article in articles %}

                <a href="{{ path('app_article_show', {slug: article.slug}) }}"
                   class="bg-white rounded border border-border hover:shadow-md transition overflow-hidden group
                          {{ loop.index == 1 ? 'md:col-span-2 md:row-span-2' : '' }}">

                    {% if article.imageName %}

                        <div class="w-full overflow-hidden bg-secondary
                                    {{ loop.index == 1 ? 'h-80' : 'h-0' }}">

                            <img 
                                src="{{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_medium.webp'}) ) }}"
                                srcset="
                                {{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_small.webp'}) ) }} 300w,
                                {{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_medium.webp'}) ) }} 550w,
                                {{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_large.webp'}) ) }} 800w
                                "
                                sizes="(max-width: 768px) calc(100vw - 32px), 800px"
                                 alt="{{ article.title }}"
                                 class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                            >
                        </div>

                    {% endif %}

                    <div class="p-6">

                        <div class="flex items-center gap-2 text-muted-foreground mb-3">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4"> 
                            <path d="M8 2v4"/>
                            <path d="M16 2v4"/>
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M3 10h18"/>
                            </svg>

                            <time class="text-sm">
                                {{ article.publishedAt|format_datetime(locale='fr', pattern="d MMMM yyyy") }}
                            </time>

                        </div>

                        <h3 class="mb-3">
                            {{ article.title }}
                        </h3>

                        <p class="text-muted-foreground mb-4 line-clamp-2">
                            {{ article.shortDescription }}
                        </p>

                        <span class="text-primary inline-flex items-center gap-1">
                            <span class="group-hover:underline">Lire la suite</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 transition-transform group-hover:translate-x-1">
                                <path d="M5 12h14" />
                                <path d="m12 5 7 7-7 7" />
                            </svg>
                        </span>

                    </div>

                </a>

            {% endfor %}

        </div>

        {% if articles is empty %}
            <div class="text-center pb-12">
            <p class="text-muted-foreground">Aucune actualité récente</p>
            </div>
        {% endif %}

        <div class="text-center">
            <a href="{{ path('app_article') }}"
               class="inline-block bg-primary text-primary-foreground px-6 py-3 rounded hover:bg-primary/80 transition">
                Voir toutes les actualités
            </a>
        </div>

    </div>

</section>


{# CARTE #}
<section class="py-16 px-4 bg-white">

    <div class="max-w-7xl mx-auto">

        <h2 class="text-center mb-8">Nos établissements</h2>

        <div 
            class="relative"
            data-controller="map"
            data-map-endpoint-value="{{ path('api_map_establishments') }}"
        >
            <div
                data-map-target="map"
                class="w-full  h-[400px] md:h-[500px] rounded border border-border"
            >
            </div>

            <div
                data-map-target="overlay"
                class="absolute inset-0 flex items-center justify-center bg-black/0 transition pointer-events-none z-[1000]"
            >
                <div
                    data-map-target="message"
                    class="hidden pointer-events-auto rounded bg-white px-4 py-3 shadow text-sm text-gray-800"
                >
                    Clique sur la carte pour activer le zoom
                </div>
            </div>

            <div data-map-target="popup"></div>
        </div>

        <div class="text-center mt-8">
            <a href="{{ path('app_establishment') }}"
               class="inline-block bg-primary text-primary-foreground px-8 py-3 rounded hover:bg-primary/80 transition">
                Voir tous les établissements
            </a>
        </div>

    </div>

</section>


{# MISSIONS #}
<section class="py-16 px-4 bg-secondary">

    <div class="max-w-7xl mx-auto">

        <h2 class="text-center mb-12">Le CN2E en bref</h2>

        <div class="grid md:grid-cols-3 gap-8">

            <div class="bg-white p-6 rounded border border-border">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-12 h-12 text-primary mb-4"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <circle cx="12" cy="12" r="6"/>
            <circle cx="12" cy="12" r="2"/>
            </svg>
                <h3 class="mb-3">Coordination du réseau</h3>
                <p class="text-muted-foreground">
                    Animer et structurer le réseau national des EREA/LEA et ERPD afin de favoriser les échanges de pratiques et la cohérence des actions.
                </p>
            </div>

            <div class="bg-white p-6 rounded border border-border">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-12 h-12 text-primary mb-4"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <path d="M16 3.128a4 4 0 0 1 0 7.744"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <circle cx="9" cy="7" r="4"/>
                </svg>
                <h3 class="mb-3">Représentation</h3>
                <p class="text-muted-foreground">
                    Porter la voix des établissements auprès de l’Éducation nationale et des partenaires institutionnels.
                </p>
            </div>

            <div class="bg-white p-6 rounded border border-border">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-12 h-12 text-primary mb-4"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <h3 class="mb-3">Appui et expertise</h3>
                <p class="text-muted-foreground">
                    Accompagner les établissements sur les enjeux de l’enseignement adapté et contribuer à l’évolution des politiques éducatives.
                </p>
            </div>

        </div>

    </div>

</section>


{# ÉQUIPE #}
<section class="py-16 px-4 bg-white">

    <div class="max-w-7xl mx-auto text-center mb-12">

        <h2 class="mb-4">L'équipe du CN2E</h2>

        <p class="text-muted-foreground max-w-2xl mx-auto">
            Le bureau du CN2E est composé de professionnels de l'enseignement adapté, pour représenter et coordonner le réseau des EREA/LEA et ERPD.
        </p>

    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">

        {% for member in team %}
            {% include 'components/team_member.html.twig' with {
                prenom: member.firstName,
                nom: member.lastName,
                fonctionCN2E: member.cn2eRole,
                etablissement: member.establishment ? member.establishment.name : null,
                profession: member.profession,
                photo: member.imageName ? asset('uploads/users/' ~ member.imageName)|replace({'.webp': '_thumbnail.webp'}) : null,
                email: member.email
            } %}
        {% endfor %}

    </div>

    <div class="mt-10 text-center">
        <a href="{{ path('app_team') }}"
           class="inline-block bg-primary text-primary-foreground px-6 py-3 rounded hover:bg-primary/80 transition">
            Voir toute l'équipe
        </a>
    </div>

</section>

</div>

{% endblock %}