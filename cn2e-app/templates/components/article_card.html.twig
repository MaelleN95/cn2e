<a href="{{ path('app_article_show', { slug: article.slug }) }}"
   class="flex flex-col bg-white border border-border rounded overflow-hidden hover:shadow-md transition-shadow group">

  {% if article.imageName %}
    <div class="aspect-video overflow-hidden bg-secondary">
      <img
        src="{{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_medium.webp'}) ) }}"
        srcset="
          {{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_small.webp'}) ) }} 300w,
          {{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_medium.webp'}) ) }} 550w,
          {{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_large.webp'}) ) }} 800w
        "
        sizes="(max-width: 768px) calc(100vw - 32px) 400px"
        alt="{{ article.title }}"
        class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
      >
    </div>
  {% endif %}

  <div class="flex flex-col flex-1 p-6">

    <div class="flex items-center justify-between mb-3">

      <div class="flex items-center gap-2 text-muted-foreground">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4"> 
          <path d="M8 2v4"/>
          <path d="M16 2v4"/>
          <rect x="3" y="4" width="18" height="18" rx="2"/>
          <path d="M3 10h18"/>
        </svg>
        <time class="text-sm">
          {{ article.publishedAt|format_datetime(locale='fr', pattern="d MMMM yyyy") }}
        </time>
      </div>
    </div>

    <h3 class="mb-3">{{ article.title }}</h3>

    <p class="text-muted-foreground mb-4 line-clamp-2">
      {{ article.shortDescription }}
    </p>

    <div class="flex items-center justify-between mt-auto pt-4 border-t border-border">
      {% if article.category %}
        <span class="bg-primary/10 text-primary px-3 py-1 rounded text-sm">
          {{ article.category }}
        </span>
      {% endif %}

      <span class="text-primary inline-flex items-center gap-1 text-sm">
        <span class="group-hover:underline">Lire</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 transition-transform group-hover:translate-x-1">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
          </svg>
      </span>

    </div>
  </div>
</a>