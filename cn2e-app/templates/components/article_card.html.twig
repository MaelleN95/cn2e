<a href="{{ path('app_article_show', { slug: article.slug }) }}"
   class="bg-white border border-border rounded overflow-hidden hover:shadow-md transition-shadow group">

  {% if article.imageName %}
    <div class="aspect-video overflow-hidden bg-secondary">
      <img
        src="{{ asset('uploads/articles/' ~ article.imageName) }}"
        alt="{{ article.title }}"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      >
    </div>
  {% endif %}

  <div class="p-6">

    <div class="flex items-center justify-between mb-3">

      <div class="flex items-center gap-2 text-muted-foreground">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4"> 
          <path d="M8 2v4"/>
          <path d="M16 2v4"/>
          <rect x="3" y="4" width="18" height="18" rx="2"/>
          <path d="M3 10h18"/>
        </svg>
        <time class="text-sm">
          {{ article.publishedAt|format_datetime(locale='fr', pattern="d MMMM yyyy") }}
        </time>
      </div>

      {% if article.category %}
        <span class="bg-primary/10 text-primary px-3 py-1 rounded text-sm">
          {{ article.category }}
        </span>
      {% endif %}

    </div>

    <h3 class="mb-3">{{ article.title }}</h3>

    <p class="text-muted-foreground mb-4 line-clamp-2">
      {{ article.shortDescription }}
    </p>

    <div class="flex items-center justify-between mt-6 pt-4 border-t border-border">

      {% if article.author %}
        <div class="flex items-center gap-3">
          {% if article.author.imageName %}
            <img
              src="{{ asset('uploads/users/' ~ article.author.imageName) }}"
              alt="{{ article.author.firstName }} {{ article.author.lastName }}"
              class="w-8 h-8 rounded-full object-cover"
            >
          {% else %}
            <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center border border-border">
              <span class="text-primary font-semibold text-xs">
                {{ article.author.firstName|first }}{{ article.author.lastName|first }}
              </span>
            </div>
          {% endif %}
          <div class="text-xs leading-tight">
            <p class="text-muted-foreground">Rédigé par</p>
            <p class="font-medium text-foreground">
              {{ article.author.firstName }} {{ article.author.lastName }}
            </p>
          </div>
        </div>
      {% endif %}

      <span class="text-primary inline-flex items-center gap-1 text-sm">
        <span class="group-hover:underline">Lire</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 transition-transform group-hover:translate-x-1">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
          </svg>
      </span>

    </div>
  </div>
</a>