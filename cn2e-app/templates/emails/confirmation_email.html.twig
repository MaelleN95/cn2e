<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Confirmation de votre email</title>
</head>

<body style="margin:0; padding:0; background-color:#f5f5f5; font-family:Arial, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f5f5; padding:40px 0;">
    <tr>
      <td align="center">

        <!-- CONTAINER -->
        <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff; border-radius:8px; overflow:hidden;">

          <!-- HEADER -->
          <tr>
            <td style="background:#003399; color:#ffffff; padding:20px 30px;">
              <h1 style="margin:0; font-size:20px;">{{ siteInformation.shortName }}</h1>
            </td>
          </tr>

          <!-- CONTENT -->
          <tr>
            <td style="padding:30px;">

              <h2 style="margin-top:0; font-size:18px; color:#111827;">
                Confirmation de votre adresse email
              </h2>

              <p style="color:#6b7280; font-size:14px; line-height:1.5; margin-bottom:20px;">
                Merci de confirmer votre adresse email afin d’activer votre compte.
              </p>

              <!-- CTA -->
              <table cellpadding="0" cellspacing="0" style="margin:25px 0;">
                <tr>
                  <td>
                    <a href="{{ signedUrl|raw }}"
                       style="display:inline-block; background:#003399; color:#ffffff; padding:12px 18px; border-radius:6px; text-decoration:none; font-size:14px;">
                      Confirmer mon email
                    </a>
                  </td>
                </tr>
              </table>

              <!-- EXPIRATION -->
              <p style="color:#6b7280; font-size:14px; line-height:1.5;">
                Ce lien expirera dans :
                <strong style="color:#111827;">
                  {{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}
                </strong>
              </p>

              <!-- fallback -->
              <p style="color:#6b7280; font-size:12px; line-height:1.5; margin-top:20px;">
                Si le bouton ne fonctionne pas, vous pouvez copier-coller le lien suivant dans votre navigateur :
              </p>

              <p style="word-break:break-all; font-size:12px;">
                <a href="{{ signedUrl|raw }}" style="color:#2563eb;">
                  {{ signedUrl|raw }}
                </a>
              </p>

            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding:20px 30px; background:#f9fafb; font-size:12px; color:#6b7280;">
              Email automatique — merci de ne pas répondre.
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>