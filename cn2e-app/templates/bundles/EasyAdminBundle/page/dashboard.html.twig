{% extends '@!EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    Tableau de bord
{% endblock %}

{% block main %}

<div class="mb-8">
    <p class="text-gray-400">
        Bienvenue, {{ app.user.firstName }} {{ app.user.lastName }}
    </p>
</div>

{# STATS #}
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

    {% if is_granted('ROLE_CN2E_ADMIN') %}
        <div class="bg-[#0f1115] border !border-gray-800 rounded p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="bg-blue-500 p-3 rounded text-white">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-6 h-6 text-primary"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 21a8 8 0 0 0-16 0"/>
                        <circle cx="10" cy="8" r="5"/>
                        <path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3"/>
                    </svg>
                </div>
            </div>

            <div class="text-3xl font-bold mb-1">{{ usersCount }}</div>
            <div class="text-sm text-gray-400">Utilisateurs</div>
        </div>
    {% endif %}

    <div class="bg-[#0f1115] border !border-gray-800 rounded p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="bg-green-500 p-3 rounded text-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                    class="w-6 h-6 text-primary">
                    <path d="M10 12h4"/>
                    <path d="M10 8h4"/>
                    <path d="M14 21v-3a2 2 0 0 0-4 0v3"/>
                    <path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"/>
                    <path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"/>
                </svg>
            </div>
        </div>
        <div class="text-3xl font-bold mb-1">{{ establishmentsCount }}</div>
        <div class="text-sm text-gray-400">Établissements</div>
    </div>

    <div class="bg-[#0f1115] border !border-gray-800 rounded p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="bg-purple-500 p-3 rounded text-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-primary">
                    <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/>
                    <path d="M14 2v5a1 1 0 0 0 1 1h5"/>
                    <path d="M10 9H8"/>
                    <path d="M16 13H8"/>
                    <path d="M16 17H8"/>
                </svg>
            </div>
        </div>
        <div class="text-3xl font-bold mb-1">{{ articlesCount }}</div>
        <div class="text-sm text-gray-400">Actualités</div>
    </div>

    <div class="bg-[#0f1115] border !border-gray-800 rounded p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="bg-orange-500 p-3 rounded text-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-primary">
                    <path d="M8 2v4"/>
                    <path d="M16 2v4"/>
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <path d="M3 10h18"/>
                    <path d="M8 14h.01"/>
                    <path d="M12 14h.01"/>
                    <path d="M16 14h.01"/>
                    <path d="M8 18h.01"/>
                    <path d="M12 18h.01"/>
                    <path d="M16 18h.01"/>
                </svg>
            </div>
        </div>
        <div class="text-3xl font-bold mb-1">{{ eventsCount }}</div>
        <div class="text-sm text-gray-400">Événements</div>
    </div>

    <div class="bg-[#0f1115] border !border-gray-800 rounded p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="bg-blue-500 p-3 rounded text-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-primary">
                    <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/>
                    <path d="M22 10v6"/>
                    <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>
                </svg>
            </div>
        </div>
        <div class="text-3xl font-bold mb-1">{{ academicProgramCount }}</div>
        <div class="text-sm text-gray-400">Formations proposées</div>
    </div>

</div>

{% endblock %}