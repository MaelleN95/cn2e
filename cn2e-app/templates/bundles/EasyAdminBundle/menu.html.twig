{% extends '@!EasyAdmin/menu.html.twig' %}

{% block menu_item %}

    {% if menuItem.type == 'section' %}

        <div class="mt-6 mb-2 px-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
            {{ menuItem.label|trans }}
        </div>

    {% else %}

        {% set isActive = menuItem.isSelected %}

        <li class="list-none">

            <a href="{{ menuItem.linkUrl }}"
               class="
                   flex items-center mt-2 gap-2 px-4 py-3 rounded transition
                   text-sm
                   {{
                       isActive
                           ? 'bg-primary text-white'
                           : 'text-gray-400 hover:bg-gray-800 hover:text-gray-200'
                   }}
               ">

                {% if menuItem.icon is not empty %}
                    <twig:ea:Icon name="{{ menuItem.icon }}" class="w-4 h-4" />
                {% endif %}

                <span>
                    {{ menuItem.label|trans }}
                </span>

                {% if menuItem.badge is not empty %}
                    <span class="ml-auto text-xs px-2 py-0.5 rounded bg-red-600 text-white">
                        {{ menuItem.badge }}
                    </span>
                {% endif %}

            </a>

        </li>

    {% endif %}

{% endblock %}