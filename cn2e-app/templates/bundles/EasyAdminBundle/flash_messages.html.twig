{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="fixed top-4 right-4 z-1010">
            <div class="
                px-4 py-3 rounded shadow-lg text-white
                {% if label == 'success' %} bg-green-600 {% endif %}
                {% if label == 'error' %} bg-red-600 {% endif %}
                {% if label == 'warning' %} bg-yellow-600 {% endif %}
            ">
                {{ message }}
            </div>
        </div>
    {% endfor %}
{% endfor %}