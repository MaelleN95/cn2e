<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{% endblock %} - {{ siteInformation.shortName }}</title>
        <link rel="icon" href="/CN2E-favicon.ico">
        <link rel="icon" type="image/png" sizes="48x48" href="{{ asset('images/logos/logo-CN2E-favicon-48.png') }}">
        <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('images/logos/logo-CN2E-favicon-192.png') }}">
        {% block stylesheets %}
            <link rel="stylesheet" href="/build/app.css">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="min-h-screen flex flex-col">
        {% include 'layout/header.html.twig' %}
        <main class="flex-1 pt-16 selection:bg-primary selection:text-primary-foreground">
            {% block body %}{% endblock %}
        </main>
        {% include 'layout/footer.html.twig' %}
    </body>
</html>
