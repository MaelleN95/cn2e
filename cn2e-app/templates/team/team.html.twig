{% extends 'base.html.twig' %}

{% block title %}Notre équipe{% endblock %}

{% block body %}

{% include 'components/breadcrumb.html.twig' with {
  items: [
    { label: "L'équipe du " ~ siteInformation.shortName }
  ]
} %}

<div class="max-w-7xl mx-auto px-4 py-12">

  <div class="text-center mb-12">
    <h1 class="mb-4">L'équipe du {{ siteInformation.shortName }}</h1>

    <p class="text-muted-foreground max-w-3xl mx-auto">
      Le {{ siteInformation.shortName }} réunit des représentants des établissements EREA, LEA et ERPD.
      Ils contribuent aux travaux du comité et assurent le lien entre les établissements et les instances nationales.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

    {% for user in members %}
      {% include 'components/team_member.html.twig' with {
        prenom: user.firstName,
        nom: user.lastName,
        fonctionCN2E: user.cn2eRole,
        etablissement: user.establishment ? user.establishment.name : null,
        profession: user.profession,
        photo: user.imageName ? asset('uploads/users/' ~ user.imageName)|replace({'.webp': '_thumbnail.webp'}) : null,
        email: user.email
      } %}
    {% endfor %}

  </div>

</div>

{% endblock %}