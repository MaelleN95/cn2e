{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block body %}

{% include 'components/breadcrumb.html.twig' with {
  items: [
    { label: 'Agenda', path: path('app_event') },
    { label: event.title }
  ]
} %}

<article class="max-w-4xl mx-auto px-4 py-12">

  <div class="flex items-center justify-between mb-6">
    <a href="{{ path('app_event') }}"
       class="inline-flex items-center gap-2 text-primary hover:underline">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4">
        <path d="m12 19-7-7 7-7"/>
        <path d="M19 12H5"/>
      </svg>
      Retour à l'agenda
    </a>

    {% if event.category %}
      <span class="bg-primary/10 text-primary px-4 py-2 rounded">
        {{ event.category }}
      </span>
    {% endif %}
  </div>

  <h1 class="mb-6">{{ event.title }}</h1>

  {# INFOS #}
  <div class="bg-accent p-6 rounded mb-8 space-y-3">

    <div class="flex items-center gap-3">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-5 h-5 text-primary">
        <path d="M8 2v4"/>
        <path d="M16 2v4"/>
        <rect x="3" y="4" width="18" height="18" rx="2"/>
        <path d="M3 10h18"/>
      </svg>
      <div>
        <span class="font-medium">Date : </span>

        {% if event.endDate %}
          Du {{ event.startDate|format_datetime(locale='fr', pattern="d MMMM yyyy") }}
          au {{ event.endDate|format_datetime(locale='fr', pattern="d MMMM yyyy") }}
        {% else %}
          {{ event.startDate|format_datetime(locale='fr', pattern="d MMMM yyyy") }}
        {% endif %}
      </div>
    </div>

    <div class="flex items-center gap-3">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-5 h-5 text-primary">
          <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
      <div>
        <span class="font-medium">Lieu : </span>
        {{ event.location }}
      </div>
    </div>

    <div class="flex items-center gap-3">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-5 h-5 text-primary">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 6v6l4 2"/>
        </svg>
      <div>
        <span class="font-medium">Horaires : </span>
        {{ event.time }}
      </div>
    </div>

  </div>

  {# IMAGE #}
  {% if event.image %}
    <div class="mb-8 rounded overflow-hidden">
      <img src="{{ event.image }}" alt="{{ event.title }}" class="w-full h-auto">
    </div>
  {% endif %}

  <div class="space-y-2">
    {{ event.content|raw }}
  </div>

  {% if not isPast and event.hasRegistration %}
    <div class="mt-8 p-6 bg-primary/5 border border-primary/20 rounded">
      <h3 class="mb-3">Inscription</h3>
      <p class="text-muted-foreground mb-4">
        Pour participer à cet événement, veuillez nous contacter via le formulaire de contact ou par email.
      </p>
      <a href="{{ path('app_contact') }}"
         class="inline-block bg-primary text-primary-foreground px-6 py-3 rounded hover:bg-primary/90 transition-colors">
        Nous contacter
      </a>
    </div>
  {% endif %}

  <div class="mt-12 pt-8 border-t border-border">
    <a href="{{ path('app_event') }}"
       class="inline-flex items-center gap-2 text-primary hover:underline">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4">
        <path d="m12 19-7-7 7-7"/>
        <path d="M19 12H5"/>
      </svg>
      Retour à l'agenda
    </a>
  </div>

</article>

{% endblock %}