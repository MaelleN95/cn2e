{% extends 'base.html.twig' %}

{% block title %}Agenda{% endblock %}

{% block body %}

<div>

  {% include 'components/breadcrumb.html.twig' with {
    items: [{ label: 'Agenda' }]
  } %}

  <div class="max-w-7xl mx-auto px-4 py-12">

  <div class="text-center mb-12">
    <h1 class="mb-4 inline-flex items-center justify-center gap-3">
      Agenda
      <span class="relative inline-flex items-center group">
        <button type="button"
                class="h-7 w-7 rounded-full border border-border bg-secondary/10 text-primary shadow-sm transition hover:bg-secondary/70 focus:z-10 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background cursor-help"
                aria-describedby="news-info-tooltip"
                aria-label="Plus d'informations sur l'accès aux contenus">
          <span class="font-semibold">i</span>
        </button>

        <div id="news-info-tooltip"
             role="tooltip"
             class="pointer-events-none absolute left-1/2 top-full z-10 mt-3 w-80 -translate-x-1/2 rounded border border-border bg-background px-4 py-3 text-left text-sm text-foreground shadow-xl opacity-0 transition duration-150 ease-out group-hover:opacity-100 group-focus-within:opacity-100">
          <p class="font-semibold text-sm text-foreground">Plus de contenu disponible</p>
          <p class="mt-1 text-sm text-muted-foreground">
            Connectez-vous pour consulter davantage d’événements, y compris les contenus réservés aux membres.
          </p>
        </div>
      </span>
    </h1>

    <p class="text-muted-foreground max-w-3xl mx-auto">
       Retrouvez tous les événements, séminaires, formations et rencontres organisés par le CN2E et le réseau des EREA/LEA et ERPD.
    </p>
  </div>

    <div class="flex justify-center mb-12">
      <div class="inline-flex bg-secondary rounded p-1">

        <a href="{{ path('app_event', { tab: 'a-venir' }) }}"
           class="px-6 py-2 rounded transition-colors text-base font-medium leading-[1.5]
           {{ activeTab == 'a-venir'
              ? 'bg-white shadow-sm text-primary'
              : 'text-muted-foreground hover:text-foreground' }}">
          À venir
        </a>

        <a href="{{ path('app_event', { tab: 'passes' }) }}"
           class="px-6 py-2 rounded transition-colors text-base font-medium leading-[1.5]
           {{ activeTab == 'passes'
              ? 'bg-white shadow-sm text-primary'
              : 'text-muted-foreground hover:text-foreground' }}">
          Passés
        </a>

      </div>
    </div>

    <div class="grid gap-6">

      {% for event in events %}
          {% if event.isMembersOnly and not isMember %}
            {% include 'components/event_locked_card.html.twig' %}
          {% else %}
            {% include 'components/event_card.html.twig' with { event: event } %}
          {% endif %}
      {% else %}
        <div class="text-center py-12">
          <p class="text-muted-foreground">Aucun événement pour le moment</p>
        </div>
      {% endfor %}

    </div>

  </div>
</div>

{% endblock %}