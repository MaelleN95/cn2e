{% extends 'base.html.twig' %}

{% block body %}

{% include 'components/breadcrumb.html.twig' with {
  items: [{ label: 'Contact' }]
} %}

<div class="max-w-7xl mx-auto px-4 py-12">

  <div class="text-center mb-12">
    <h1 class="mb-4">Nous contacter</h1>
    <p class="text-muted-foreground max-w-3xl mx-auto">
      Vous êtes professionnel de l'enseignement adapté ou partenaire ? Contactez-nous.
    </p>
  </div>

  {% for message in app.flashes('success') %}
    <div class="mb-6 p-4 bg-green-100 text-green-800 rounded">
      {{ message }}
    </div>
  {% endfor %}

  <div class="grid lg:grid-cols-2 gap-12">

    <div>
      <h2 class="mb-6">Envoyez-nous un message</h2>

      {{ form_start(form, { attr: { class: 'space-y-6' } }) }}

        {{ form_row(form.name) }}
        {{ form_row(form.email) }}
        {{ form_row(form.objectMessage) }}
        {{ form_row(form.message) }}

        <div class="hidden">
          {{ form_widget(form.honeypot) }}
        </div>

        <button class="w-full bg-primary text-primary-foreground px-6 py-3 rounded hover:bg-primary/90">
          Envoyer le message
        </button>

        <p class="text-sm text-muted-foreground">
          Conformément au RGPD, vous disposez d’un droit d’accès, rectification et suppression.
        </p>

      {{ form_end(form) }}

    </div>


  </div>
</div>

{% endblock %}