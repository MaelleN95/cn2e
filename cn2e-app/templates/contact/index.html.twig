{% extends 'base.html.twig' %}

{% block title %}Nous contacter{% endblock %}

{% block body %}

{% include 'components/breadcrumb.html.twig' with {
  items: [{ label: 'Contact' }]
} %}

<div class="max-w-7xl mx-auto px-4 py-12">

  {# HEADER #}
  <div class="text-center mb-12">
    <h1 class="mb-4">Nous contacter</h1>
    <p class="text-muted-foreground max-w-3xl mx-auto">
      Vous êtes professionnel de l'enseignement adapté, partenaire institutionnel ou souhaitez obtenir
      des informations sur le {{ siteInformation.shortName }} ? N'hésitez pas à nous contacter.
    </p>
  </div>

  {% include 'components/flash_messages.html.twig' %}

  {# ERREURS FORM #}
  {% if form.vars.errors|length > 0 %}
    <div class="mb-6 p-4 bg-red-100 text-red-800 rounded">
      <ul>
        {% for error in form.vars.errors %}
          <li>{{ error.message }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  <div class="grid lg:grid-cols-2 gap-12">

    <div>
      <h2 class="mb-6">Envoyez-nous un message</h2>

      {{ form_start(form, { attr: { class: 'space-y-6' } }) }}

        {{ form_row(form.name) }}
        {{ form_row(form.email) }}
        {{ form_row(form.objectMessage) }}
        <div data-controller="char-counter" data-char-counter-max-value="3000" class="space-y-2">
          {{ form_label(form.message) }}
          {{ form_widget(form.message, {
            attr: {
              'data-char-counter-target': 'input',
              'data-action': 'input->char-counter#input',
              'rows': 6,
              'class': (form.message.vars.attr.class|default('') ~ ' w-full px-4 py-3 border rounded bg-white focus:outline-none focus:ring-2 ' ~ (form.message.vars.errors|length ? ' !border-red-500 focus:ring-red-500 ' : '!border-border focus:ring-primary'))|trim,
            }
          }) }}

          <div class="flex justify-between text-sm text-muted-foreground">
            <span>Maximum 3000 caractères</span>
            <span>
              <span data-char-counter-target="count">0</span> / 3000
            </span>
          </div>

          {{ form_errors(form.message) }}
        </div>
        {# Honeypot caché #}
        <div class="hidden">
          {{ form_widget(form.website) }}
        </div>
        {# Timing #}
        <input type="hidden" name="_form_start_time" value="{{ 'now'|date('U') }}">

        <button
          type="submit"
          class="w-full bg-primary text-primary-foreground px-6 py-3 rounde hover:bg-primary/80 transition-colors cursor-pointer"
        >
          Envoyer le message
        </button>

        <p class="text-sm text-muted-foreground">
          Les informations recueillies font l'objet d'un traitement informatique destiné à répondre à
          votre demande. Conformément au RGPD, vous disposez d'un droit d'accès, de rectification et de
          suppression de vos données.
        </p>

      {{ form_end(form) }}
    </div>

    <div>
      <h2 class="mb-6">Coordonnées</h2>

      <div class="space-y-6">

        {# Adresse #}
        <div class="bg-accent p-6 rounde">
          <div class="flex items-start gap-4 mb-4">
            <svg class="w-6 h-6 text-primary flex-shrink-0 mt-1" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <div>
              <h3 class="mb-2">Adresse</h3>
              <p class="text-muted-foreground">
                {{ siteInformation.displayName }}<br>
                {{ siteInformation.postalAddressLine1 }}<br>
                {% if siteInformation.postalAddressLine2 %}
                  {{ siteInformation.postalAddressLine2 }}<br>
                {% endif %}
                {{ siteInformation.postalCode }} {{ siteInformation.city }}<br>
                {{ siteInformation.country }}
              </p>
            </div>
          </div>
        </div>

        {# Email #}
        <div class="bg-accent p-6 rounded">
          <div class="flex items-start gap-4 mb-4">
          <svg class="w-6 h-6 text-primary flex-shrink-0 mt-1" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/>
            <rect x="2" y="4" width="20" height="16" rx="2"/>
          </svg>
            <div>
              <h3 class="mb-2">Email</h3>
              <a href="mailto:{{ siteInformation.contactEmail }}" class="text-primary hover:underline">
                {{ siteInformation.contactEmail }}
              </a>
            </div>
          </div>
        </div>

        {# Bloc membre #}
        <div class="bg-primary/5 border border-primary/20 p-6 rounded">
          <h3 class="mb-3">Professionnels de l'enseignement adapté</h3>
          <p class="text-muted-foreground mb-4">
            Vous êtes directeur, enseignant ou personnel d'un EREA/LEA ou ERPD ? Connectez-vous à votre espace
            pour accéder aux ressources et services réservés aux membres du réseau.
          </p>
          <a href="{{ path('app_login') }}" class="inline-flex text-primary items-center gap-1 group">
            <span class="group-hover:underline">Accéder à l'espace membre</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true" class="w-4 h-4 transition-transform group-hover:translate-x-1">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>
    </div>

  </div>
</div>

{% endblock %}