{% extends 'base.html.twig' %}

{% block title %}Archives{% endblock %}

{% block body %}

{% include 'components/breadcrumb.html.twig' with {
  items: [
    { label: 'Actualités', path: path('app_article') },
    { label: 'Archives' }
  ]
} %}

<div class="max-w-7xl mx-auto px-4 py-12">

  <div class="text-center mb-12">
    <h1 class="mb-4">Archives des actualités</h1>
    <p class="text-muted-foreground max-w-3xl mx-auto">
      Retrouvez toutes les actualités du CN2E et du réseau des établissements EREA, LEA et ERPD de plus d'un an.
    </p>
  </div>

  {% if years is empty %}
    <div class="text-center py-12 bg-secondary rounded">
      <p class="text-muted-foreground">Aucune actualité archivée</p>
    </div>
  {% else %}

    <div class="space-y-12">

      {% for year in years %}
        <section id="year-{{ year }}">

          <div class="flex items-center gap-3 mb-6">
            <div class="h-px flex-1 bg-border"></div>
            <h2 class="text-2xl font-semibold text-primary">{{ year }}</h2>
            <div class="h-px flex-1 bg-border"></div>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

            {% for article in groupedArticlesByYear[year] %}
              {% if article.isMembersOnly and not is_granted('ROLE_CN2E_MEMBER') %}
                {% include 'components/article_locked_card.html.twig' %}
              {% else %}
                {% include 'components/article_card.html.twig' with { article: article } %}
              {% endif %}
            {% endfor %}

          </div>

        </section>
      {% endfor %}

    </div>

  {% endif %}

</div>

{% endblock %}