{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}

<div>

  {% set items = [
    { label: 'Actualités', path: path('app_article') }
  ] %}

  {% if article.publishedAt and article.publishedAt < date('-1 year') %}
    {% set year = article.publishedAt|format_datetime(locale='fr', pattern="yyyy") %}
    {% set items = items|merge([
      { label: 'Archives', path: path('app_article_archive') }
    ]) %}
    {% set items = items|merge([
      { label: year|upper, path: path('app_article_archive') ~ '#year-' ~ year }
    ]) %}
  {% endif %}

  {% set items = items|merge([
    { label: article.title }
  ]) %}

  {% include 'components/breadcrumb.html.twig' with {
    items: items
  } %}

  <article class="max-w-4xl mx-auto px-4 py-12">

    <div class="flex items-center justify-between mb-6">
      <a href="{{ path('app_article') }}"
         class="inline-flex items-center gap-2 text-primary hover:underline mb-6">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4">
          <path d="m12 19-7-7 7-7"/>
          <path d="M19 12H5"/>
        </svg>
        Retour aux actualités
      </a>

      {% if article.category %}
        <span class="inline-block bg-primary/10 text-primary px-4 py-2 rounded mb-4">
          {{ article.category }}
        </span>
      {% endif %}
    </div>

    <h1 class="mb-4">{{ article.title }}</h1>

    <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground mb-8">

      <div class="flex items-center gap-2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4"> 
          <path d="M8 2v4"/>
          <path d="M16 2v4"/>
          <rect x="3" y="4" width="18" height="18" rx="2"/>
          <path d="M3 10h18"/>
        </svg>
        <time>
          {{ article.publishedAt|format_datetime(locale='fr', pattern="d MMMM yyyy") }}
        </time>
      </div>

      {% if article.author %}
        <span class="hidden sm:inline text-border">•</span>

        <div class="flex items-center gap-2">
          {% if article.author.imageName %}
            <img
              src="{{ asset('uploads/users/' ~ article.author.imageName|replace({'.webp': '_thumbnail.webp'}) ) }}"
              class="w-6 h-6 rounded-full object-cover"
              alt="{{ article.author.firstName }} {{ article.author.lastName }}"
            >
          {% else %}
            <div class="w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center border border-border">
              <span class="text-primary font-semibold text-xs">
                {{ article.author.firstName|first }}{{ article.author.lastName|first }}
              </span>
            </div>
          {% endif %}
          <span>
            {{ article.author.firstName }} {{ article.author.lastName }}
            {% if article.author.cn2eRole %}
              ({{ article.author.cn2eRole }})
            {% endif %}
          </span>
        </div>
      {% endif %}

    </div>

    {% if article.imageName %}
      <div class="mb-8 rounded overflow-hidden">
        <img
          src="{{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_medium.webp'}) ) }}"
          srcset="
            {{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_small.webp'}) ) }} 300w,
            {{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_medium.webp'}) ) }} 550w,
            {{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_large.webp'}) ) }} 800w
          "
          sizes="(max-width: 768px) calc(100vw - 32px), 800px"
          alt="{{ article.title }}"
          class="w-full h-auto object-cover"
        >
      </div>
    {% endif %}

    {% if article.documents|length > 0 %}
      <div class="my-5">
        <h2 class="text-xl font-semibold mb-4">Documents associés</h2>

        <div class="space-y-6">
          {% for doc in article.documents %}
            <div class="border border-border rounded overflow-hidden">

              <div class="p-3 border-b border-border flex justify-between items-center">
                <span class="text-sm text-muted-foreground">
                  Aperçu du document
                </span>

                <a
                  href="{{ asset('uploads/articles/pdfs/' ~ doc.pdfName) }}"
                  target="_blank"
                  class="text-primary hover:underline inline-flex items-center gap-1"
                >
                  <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h6v6"/>
                    <path d="M10 14 21 3"/>
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  </svg>
                  Ouvrir dans un nouvel onglet
                </a>
              </div>

              <iframe
                src="{{ asset('uploads/articles/pdfs/' ~ doc.pdfName) }}"
                class="w-full h-[300px]"
              ></iframe>

            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="rich-text space-y-1 leading-relaxed">
      {{ article.content|raw }}
    </div>

    <div class="mt-12 pt-8 border-t border-border">
      <a href="{{ path('app_article') }}"
         class="inline-flex items-center gap-2 text-primary hover:underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4">
          <path d="m12 19-7-7 7-7"/>
          <path d="M19 12H5"/>
        </svg>
        Retour aux actualités
      </a>
    </div>

  </article>
</div>

{% endblock %}