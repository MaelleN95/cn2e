{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}

<div>

  {% set items = [
    { label: 'Actualités', path: path('app_article') }
  ] %}

  {% if article.publishedAt and article.publishedAt < date('-1 year') %}
    {% set year = article.publishedAt|format_datetime(locale='fr', pattern="yyyy") %}
    {% set items = items|merge([
      { label: 'Archives', path: path('app_article_archive') }
    ]) %}
    {% set items = items|merge([
      { label: year|upper, path: path('app_article_archive') ~ '#year-' ~ year }
    ]) %}
  {% endif %}

  {% set items = items|merge([
    { label: article.title }
  ]) %}

  {% include 'components/breadcrumb.html.twig' with {
    items: items
  } %}

  <article class="max-w-4xl mx-auto px-4 py-12">

    <div class="flex items-center justify-between mb-6">
      <a href="{{ path('app_article') }}"
         class="inline-flex items-center gap-2 text-primary hover:underline mb-6">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4">
          <path d="m12 19-7-7 7-7"/>
          <path d="M19 12H5"/>
        </svg>
        Retour aux actualités
      </a>

      {% if article.category %}
        <span class="inline-block bg-primary/10 text-primary px-4 py-2 rounded mb-4">
          {{ article.category }}
        </span>
      {% endif %}
    </div>

    <h1 class="mb-4">{{ article.title }}</h1>

    <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground mb-8">

      <div class="flex items-center gap-2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4"> 
          <path d="M8 2v4"/>
          <path d="M16 2v4"/>
          <rect x="3" y="4" width="18" height="18" rx="2"/>
          <path d="M3 10h18"/>
        </svg>
        <time>
          {{ article.publishedAt|format_datetime(locale='fr', pattern="d MMMM yyyy") }}
        </time>
      </div>

      {% if article.author %}
        <span class="hidden sm:inline text-border">•</span>

        <div class="flex items-center gap-2">
          {% if article.author.imageName %}
            <img
              src="{{ asset('uploads/users/' ~ article.author.imageName|replace({'.webp': '_thumbnail.webp'}) ) }}"
              class="w-6 h-6 rounded-full object-cover"
              alt="{{ article.author.firstName }} {{ article.author.lastName }}"
            >
          {% else %}
            <div class="w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center border border-border">
              <span class="text-primary font-semibold text-xs">
                {{ article.author.firstName|first }}{{ article.author.lastName|first }}
              </span>
            </div>
          {% endif %}
          <span>
            {{ article.author.firstName }} {{ article.author.lastName }}
            {% if article.author.cn2eRole %}
              ({{ article.author.cn2eRole }})
            {% endif %}
          </span>
        </div>
      {% endif %}

    </div>

    {% if article.imageName %}
      <div class="mb-8 rounded overflow-hidden">
        <img
          src="{{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_medium.webp'}) ) }}"
          srcset="
            {{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_small.webp'}) ) }} 300w,
            {{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_medium.webp'}) ) }} 550w,
            {{ asset('uploads/articles/' ~ article.imageName|replace({'.webp': '_large.webp'}) ) }} 800w
          "
          sizes="(max-width: 768px) calc(100vw - 32px), 800px"
          alt="{{ article.title }}"
          class="w-full h-auto object-cover"
        >
      </div>
    {% endif %}

    <div class="rich-text space-y-1 leading-relaxed">
      {{ article.content|raw }}
    </div>

    {% if article.videoUrl %}
      <div class="my-10">
        <h2 class="font-semibold mb-6">
          Vidéo associée
        </h2>

        <div class="aspect-video w-full overflow-hidden rounded border border-border shadow-sm">
          {{ article.videoUrl|video_embed }}
        </div>
      </div>
    {% endif %}

    {% if article.documents|length > 0 %}
      <div class="my-10">
        <h2 class="font-semibold mb-6">
          Documents associés
        </h2>

        <div class="space-y-8">
          {% for doc in article.documents %}
            {# Desktop #}
            <div class="hidden md:block overflow-hidden rounded-xl border border-border bg-card shadow-sm">

              <div class="flex flex-col gap-4 border-b border-border p-5 sm:flex-row sm:items-center sm:justify-between">

                <div class="flex items-center gap-3">
                  <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                    <svg
                      viewBox="0 0 24 24"
                      class="h-5 w-5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <path d="M14 2v6h6"/>
                    </svg>
                  </div>

                  <div>
                    <p class="font-medium">
                      {% if article.documents|length > 1 %}
                        Document n°{{ loop.index }}
                      {% else %}
                        Document PDF
                      {% endif %}
                    </p>

                    <p class="text-sm text-muted-foreground">
                      Aperçu intégré
                    </p>
                  </div>
                </div>

                <a
                  href="{{ asset('uploads/articles/pdfs/' ~ doc.pdfName) }}"
                  target="_blank"
                  class="inline-flex items-center gap-2 rounded-md border border-border px-3 py-2 text-sm transition hover:bg-muted"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M15 3h6v6"/>
                    <path d="M10 14 21 3"/>
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  </svg>

                  Ouvrir le PDF
                </a>

              </div>

              <iframe
                src="{{ asset('uploads/articles/pdfs/' ~ doc.pdfName) }}"
                class="h-[450px] w-full bg-white"
              ></iframe>

            </div>

            {# Mobile #}
            <div class="md:hidden overflow-hidden rounded-xl border border-border bg-card shadow-sm">

              <div class="flex flex-col items-center justify-center gap-4 p-8 text-center">

                <div class="flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-primary">
                  <svg
                    viewBox="0 0 24 24"
                    class="h-7 w-7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <path d="M14 2v6h6"/>
                  </svg>
                </div>

                <div>
                  <p class="font-medium mb-1">
                    Aperçu {% if article.documents|length > 1 %} du document n°{{ loop.index }}
                      {% else %} du document PDF{% endif %}
                  </p>

                  <p class="text-sm text-muted-foreground">
                    L'aperçu des documents PDF n'est pas disponible sur téléphone.
                  </p>
                </div>

                <a
                  href="{{ asset('uploads/articles/pdfs/' ~ doc.pdfName) }}"
                  target="_blank"
                  class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-primary-foreground transition hover:opacity-90"
                >
                  Ouvrir dans un nouvel onglet
                </a>

              </div>

            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="mt-12 pt-8 border-t border-border">
      <a href="{{ path('app_article') }}"
         class="inline-flex items-center gap-2 text-primary hover:underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-4 h-4">
          <path d="m12 19-7-7 7-7"/>
          <path d="M19 12H5"/>
        </svg>
        Retour aux actualités
      </a>
    </div>

  </article>
</div>

{% endblock %}