{% extends 'base.html.twig' %}

{% block body %}

{% include 'components/breadcrumb.html.twig' with {
  items: [{ label: 'Actualités' }]
} %}

<div class="max-w-7xl mx-auto px-4 py-12">

  <div class="text-center mb-12">
    <h1 class="mb-4">Actualités</h1>
    <p class="text-muted-foreground max-w-3xl mx-auto">
      Retrouvez les actualités récentes du CN2E et du réseau des établissements.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

    {% for article in articles %}
      <a href="{{ path('app_article', { id: article.id }) }}"
         class="bg-white border border-border rounded overflow-hidden hover:shadow-md transition-shadow group">

        {% if article.image %}
          <div class="aspect-video overflow-hidden bg-secondary">
            <img
              src="{{ article.image }}"
              alt="{{ article.title }}"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            >
          </div>
        {% endif %}

        <div class="p-6">

          {# Header #}
          <div class="flex items-center justify-between mb-3">

            <div class="flex items-center gap-2 text-muted-foreground">
              <span>📅</span>
              <time class="text-sm">
                {{ article.publishedAt|format_datetime(locale='fr', pattern="d MMMM yyyy") }}
              </time>
            </div>

            {% if article.category %}
              <span class="bg-primary/10 text-primary px-3 py-1 rounded text-sm">
                {{ article.category }}
              </span>
            {% endif %}

          </div>

          <h3 class="mb-3">{{ article.title }}</h3>
          <p class="text-muted-foreground mb-4">{{ article.shortDescription }}</p>

          {# Footer #}
          <div class="flex items-center justify-between mt-6 pt-4 border-t border-border">

            {% if article.author %}
              <div class="flex items-center gap-3">
                <img
                  src="{{ article.author.profilePicture }}"
                  alt="{{ article.author.firstName }} {{ article.author.lastName }}"
                  class="w-8 h-8 rounded-full object-cover"
                >
                <div class="text-xs leading-tight">
                  <p class="text-muted-foreground">Rédigé par</p>
                  <p class="font-medium text-foreground">
                    {{ article.author.firstName }} {{ article.author.lastName }}
                  </p>
                </div>
              </div>
            {% endif %}

            <span class="text-primary inline-flex items-center gap-1 text-sm">
              <span class="group-hover:underline">Lire</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </span>

          </div>

        </div>
      </a>
    {% endfor %}

  </div>

  {% if articles is empty %}
    <div class="text-center py-12">
      <p class="text-muted-foreground">Aucune actualité récente</p>
    </div>
  {% endif %}

  {% if archivesCount > 0 %}
    <div class="mt-12 text-center">
      <a href="{{ path('app_article_archive') }}"
         class="inline-flex items-center gap-2 bg-secondary text-foreground px-6 py-3 rounded hover:bg-secondary/80 transition-colors border border-border">
        📦 Consulter les archives ({{ archivesCount }} actualité{{ archivesCount > 1 ? 's' : '' }})
      </a>
    </div>
  {% endif %}

</div>

{% endblock %}