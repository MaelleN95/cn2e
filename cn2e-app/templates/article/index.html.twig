{% extends 'base.html.twig' %}

{% block body %}

{% include 'components/breadcrumb.html.twig' with {
  items: [{ label: 'Actualités' }]
} %}

<div class="max-w-7xl mx-auto px-4 py-12">

  <div class="text-center mb-12">
    <h1 class="mb-4">Actualités</h1>
    <p class="text-muted-foreground max-w-3xl mx-auto">
      Retrouvez les actualités récentes du CN2E et du réseau des établissements EREA, LEA et ERPD.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

  {% for article in articles %}
    {% include 'components/article_card.html.twig' with { article: article } %}
  {% endfor %}

  </div>

  {% if articles is empty %}
    <div class="text-center py-12">
      <p class="text-muted-foreground">Aucune actualité récente</p>
    </div>
  {% endif %}

  {% if archivesCount > 0 %}
    <div class="mt-12 text-center">
      <a href="{{ path('app_article_archive') }}"
         class="inline-flex items-center gap-2 bg-secondary text-foreground px-6 py-3 rounded hover:bg-secondary/80 transition-colors border border-border">
        📦 Consulter les archives ({{ archivesCount }} actualité{{ archivesCount > 1 ? 's' : '' }})
      </a>
    </div>
  {% endif %}

</div>

{% endblock %}