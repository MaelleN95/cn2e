{% extends 'base.html.twig' %}

{% block body %}

{% include 'components/breadcrumb.html.twig' with {
  items: [{ label: 'Actualités' }]
} %}

<div class="max-w-7xl mx-auto px-4 py-12">


  <div class="text-center mb-12">
    <h1 class="mb-4 inline-flex items-center justify-center gap-3">
      Actualités
      <span class="relative inline-flex items-center group">
        <button type="button"
                class="h-7 w-7 rounded-full border border-border bg-secondary/10 text-primary shadow-sm transition hover:bg-secondary/70 focus:z-10 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background cursor-help"
                aria-describedby="news-info-tooltip"
                aria-label="Plus d'informations sur l'accès aux contenus">
          <span class="font-semibold">i</span>
        </button>

        <div id="news-info-tooltip"
             role="tooltip"
             class="pointer-events-none absolute left-1/2 top-full z-10 mt-3 w-80 -translate-x-1/2 rounded border border-border bg-background px-4 py-3 text-left text-sm text-foreground shadow-xl opacity-0 transition duration-150 ease-out group-hover:opacity-100 group-focus-within:opacity-100">
          <p class="font-semibold text-sm text-foreground">Plus de contenu disponible</p>
          <p class="mt-1 text-sm text-muted-foreground">
            Connectez-vous pour consulter davantage d’actualités, y compris les contenus réservés aux membres.
          </p>
        </div>
      </span>
    </h1>

    <p class="text-muted-foreground max-w-3xl mx-auto">
      Retrouvez les actualités récentes du CN2E et du réseau des établissements EREA, LEA et ERPD.
    </p>
  </div>


  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
  
  {% for article in articles %}
    {% if article.isMembersOnly and not isMember %}
      {% include 'components/article_locked_card.html.twig' %}
    {% else %}
      {% include 'components/article_card.html.twig' with { article: article } %}
    {% endif %}
  {% endfor %}

  </div>

  {% if articles is empty %}
    <div class="text-center py-12">
      <p class="text-muted-foreground">Aucune actualité récente</p>
    </div>
  {% endif %}

  {% if archivesCount > 0 %}
    <div class="mt-12 text-center">
      <a href="{{ path('app_article_archive') }}"
         class="inline-flex items-center gap-2 bg-secondary text-foreground px-6 py-3 rounded hover:bg-secondary/80 transition-colors border border-border">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-5 h-5">
          <rect x="2" y="3" width="20" height="5" rx="1"/>
          <path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/>
          <path d="M10 12h4"/>
        </svg>
        Consulter les archives ({{ archivesCount }} actualité{{ archivesCount > 1 ? 's' : '' }})
      </a>
    </div>
  {% endif %}

</div>

{% endblock %}